# Vercel Production Environment Variables
# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables

# The base URL of your API. Required for mobile devices where the frontend 
# origin might not match the API host.
# Example: https://testing-the-room.vercel.app
VITE_API_URL=

# Note: VITE_APP_VERSION is automatically injected from package.json during the build process
